# =============================================================================
# FreshGuard ver3 환경변수
# =============================================================================
# ver3 아키텍처: 휴대폰 → Next.js API (이 앱) → 원격 VLM 서버 (다른 컴퓨터)
# 단일 VLM이 비전(인식) + 언어(레시피 추천 / 유통기한 추정)을 모두 처리.

# === 원격 VLM 서버 ===
# 다른 컴퓨터에서 띄우는 VLM 서버의 baseURL.
# 같은 LAN에서는 보통 http://<server-ip>:8000 형태.
FRESHGUARD_VLM_URL=http://localhost:8000

# (선택) 서버가 Bearer 토큰 인증을 요구하면 입력.
# FRESHGUARD_VLM_TOKEN=

# (선택) 타임아웃 ms — 큰 모델일수록 길게.
# VLM_RECOGNIZE_TIMEOUT_MS=60000
# VLM_SUGGEST_TIMEOUT_MS=30000
# VLM_RECIPES_TIMEOUT_MS=90000

# (선택) 업로드 전 이미지 정규화 한계.
# VLM_CLIENT_MAX_SIDE=1024
# VLM_CLIENT_JPEG_QUALITY=82

# === EC-01 음식물 처리기 가격 (kg당, 원). 환경부 종량제 평균 ≈ 600원/kg ===
# DISPOSAL_COST_PER_KG=600
# FOOD_VALUE_PER_KG=6000
